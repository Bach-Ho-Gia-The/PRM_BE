# ==========================================
# 1. APPLICATION & SERVER
# ==========================================
APP_NAME=
SERVER_PORT=8088
CONTEXT_PATH=
APP_TIMEZONE=Asia/Ho_Chi_Minh
FRONTEND_BASE_URL=http://localhost:5173

# Bật Swagger ở Local (Khi deploy set = false)
SWAGGER_ENABLED=true

# ==========================================
# 2. POSTGRESQL (LOCAL)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USERNAME=postgres
DB_PASSWORD=123456
DB_SSL_MODE=disable
# Local dùng update để tự tạo bảng, Deploy đổi thành validate
DDL_AUTO=update
SHOW_SQL=true

# ==========================================
# 3. REDIS (LOCAL)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# ==========================================
# 4. JWT & AUTH COOKIE
# ==========================================
# Key mã hóa JWT (Tối thiểu 256-bit)
JWT_SIGNER_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

AUTH_COOKIE_NAME=refresh_token
# Local chạy HTTP nên để false; Deploy có HTTPS thì đổi thành true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_PATH=/

# ==========================================
# 5. CÁC BIẾN OPTIONAL (MỞ KHI DỰ ÁN CẦN DÙNG)
# ==========================================
# MONGODB_URI=mongodb://localhost:27017/app_chat

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FRONTEND_CALLBACK_URL=http://localhost:5173/oauth2/callback

# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=System

# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=

# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=