# ==========================================
# 1. APPLICATION & SERVER
# ==========================================
APP_NAME=
SERVER_PORT=8088

# ⚠ Để TRỐNG nghĩa là context-path = "" (root), KHÔNG phải /api/v1.
#    Toàn bộ doc + FE đang viết theo /api/v1 -> phải điền rõ, đừng dựa vào default.
CONTEXT_PATH=/api/v1

APP_TIMEZONE=Asia/Ho_Chi_Minh

# ⚠ Nhiều origin thì ngăn nhau bằng DẤU PHẨY trên MỘT dòng.
#    Viết sai định dạng (thiếu "://") thì CORS không khớp và FE web bị chặn sạch.
FRONTEND_BASE_URL=http://localhost:5173,http://localhost:3000

# Bật Swagger ở Local (Khi deploy set = false)
SWAGGER_ENABLED=true

# ==========================================
# 2. POSTGRESQL (LOCAL)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USERNAME=postgres
DB_PASSWORD=123456
# Local: disable | Deploy: require
DB_SSL_MODE=disable
# Local dùng update để tự tạo bảng, Deploy đổi thành validate
DDL_AUTO=update
SHOW_SQL=true

# ==========================================
# 3. REDIS (LOCAL)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
# Để trống là ĐÚNG: Spring Data coi chuỗi rỗng là "không có mật khẩu"
REDIS_PASSWORD=
REDIS_SSL=false

# ==========================================
# 4. JWT & AUTH COOKIE
# ==========================================
# Sinh khoá:  openssl rand -base64 64 | tr -d '\n'   (tối thiểu 32 byte, rỗng = app không khởi động)
JWT_SIGNER_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

AUTH_ACCESS_COOKIE_NAME=access_token
AUTH_COOKIE_NAME=refresh_token
# Local chạy HTTP nên để false; Deploy có HTTPS thì đổi thành true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_PATH=/

# ==========================================
# 5. DỮ LIỆU KHỞI TẠO (chỉ dùng cho LocalDev)
# ==========================================
DATA_INIT_ENABLED=true
DATA_INIT_ADMIN_PASSWORD=Admin@12345
DATA_INIT_USER_PASSWORD=User@12345

# ==========================================
# 6. QUY TẮC ĐẶT HÀNG
#    (bản cũ để nhầm dưới tiêu đề "CHỐNG DÒ MẬT KHẨU")
# ==========================================
ORDER_SHIPPING_FEE=30000
ORDER_FREE_SHIPPING_THRESHOLD=1000000

# ==========================================
# 7. CHỐNG DÒ MẬT KHẨU
# ==========================================
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_LOCK_DURATION=15m

# ==========================================
# 8. OTP  (🆕 bổ sung — trước đây thiếu hẳn, chạy bằng giá trị mặc định ẩn)
# ==========================================
# Mã quên mật khẩu sống 90 giây
OTP_TTL_SECONDS=90
# Mã đăng ký sống 600 giây (10 phút)
OTP_REGISTER_TTL_SECONDS=600
# Sai quá 5 lần là huỷ mã
OTP_MAX_ATTEMPTS=5
# Vé đặt lại mật khẩu sống 300 giây
OTP_VERIFIED_TTL_SECONDS=300
# Trần số mail OTP gửi cho 1 email trong 1 giờ
OTP_MAX_SENDS_PER_HOUR=5
# Khoảng chờ giữa 2 lần bấm "Gửi lại mã"
OTP_RESEND_COOLDOWN_SECONDS=20

# Khoảng chờ giữa 2 lần ĐỔI MẬT KHẨU thành công (🆕 bổ sung)
PASSWORD_CHANGE_COOLDOWN=5m

# ==========================================
# 9. GỬI EMAIL (BREVO)
# ==========================================
BREVO_API_KEY=
# ⚠ PHẢI là địa chỉ đã verify trong CHÍNH tài khoản Brevo ứng với API key trên
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# ==========================================
# 10. ĐĂNG NHẬP GOOGLE
# ==========================================
# Phải là WEB client ID — Flutter truyền đúng giá trị này vào serverClientId
GOOGLE_CLIENT_ID=

# ⚠ KHÔNG khai GOOGLE_CLIENT_SECRET.
#    Dự án đi "đường B": frontend lấy idToken rồi gửi về backend, backend chỉ kiểm claim "aud".
#    Không có dòng nào trong src/ đọc biến đó.
